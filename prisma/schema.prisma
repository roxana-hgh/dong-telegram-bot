// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  name       String
  step       String?
  draft      Json? // داده‌ی موقت گفتگو، مثلاً { amount, description, paidBy }
  createdAt  DateTime @default(now())
  groups     Group[]
  members    Member[]
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  members     Member[]
  trips       Trip[]
  createdAt   DateTime @default(now())
}

model Member {
  id          Int            @id @default(autoincrement())
  groupId     Int
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  displayName String
  userId      Int?
  user        User?          @relation(fields: [userId], references: [id])
  paid        Expense[]
  shares      ExpenseShare[]

  @@unique([groupId, displayName])
}

enum TripStatus {
  OPEN
  SETTLED
}

model Trip {
  id        Int        @id @default(autoincrement())
  groupId   Int
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  status    TripStatus @default(OPEN)
  createdAt DateTime   @default(now())
  expenses  Expense[]
}

model Expense {
  id             Int            @id @default(autoincrement())
  tripId         Int
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidByMemberId Int
  paidBy         Member         @relation(fields: [paidByMemberId], references: [id], onDelete: NoAction)
  amount         Int //toman
  description    String
  createdAt      DateTime       @default(now())
  shares         ExpenseShare[]
}

model ExpenseShare {
  id        Int     @id @default(autoincrement())
  expenseId Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  Int
  member    Member  @relation(fields: [memberId], references: [id], onDelete: NoAction)
  amount    Int

  @@unique([expenseId, memberId])
}
